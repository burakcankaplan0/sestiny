# Sestiny backend — örnek ortam değişkenleri
# Kopyala: cp .env.example .env
# .env dosyası Git'e eklenmez. Buraya asla gerçek anahtar/şifre yazılmaz.

# Uvicorn'un dinleyeceği adres ve port
SESTINY_HOST=127.0.0.1
SESTINY_PORT=8000

# true ise ayrıntılı log yazılır. Ses içeriği hiçbir modda loglanmaz.
SESTINY_DEBUG=true

# CORS: virgülle ayrılmış izinli frontend adresleri.
# Production'da wildcard (*) kullanılmaz.
SESTINY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Yüklenen her ses dosyası için üst sınır (bayt). 10 MB.
SESTINY_MAX_UPLOAD_BYTES=10485760
