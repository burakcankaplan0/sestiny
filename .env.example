# Sestiny — örnek ortam değişkenleri
# Bu dosya şablondur ve Git'e eklenir. Gerçek değerler .env dosyasına yazılır (.env commit edilmez).
# Burada hiçbir zaman gerçek anahtar, şifre veya kişisel bilgi bulunmaz.

# ---------- Backend ----------
# Uvicorn'un dinleyeceği adres ve port
SESTINY_HOST=127.0.0.1
SESTINY_PORT=8000

# Geliştirme modu: true ise ayrıntılı log yazılır (ses içeriği yine loglanmaz)
SESTINY_DEBUG=true

# CORS: yalnızca lokal frontend adresine izin verilir. Production'da wildcard (*) kullanılmaz.
SESTINY_ALLOWED_ORIGINS=http://localhost:5173

# Yüklenen her ses dosyası için üst sınır (bayt). Varsayılan 10 MB.
SESTINY_MAX_UPLOAD_BYTES=10485760

# ---------- Frontend ----------
# Vite yalnızca VITE_ ile başlayan değişkenleri tarayıcıya aktarır.
# Bu değişkene gizli bilgi yazılmaz — tarayıcıda herkese görünür.
VITE_API_BASE_URL=http://127.0.0.1:8000
